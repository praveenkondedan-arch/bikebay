# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String (Required for production / Render)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/motobay?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET="replace-with-strong-secret-in-production"

# CORS Allowed Origin (Set to your Vercel frontend URL when deployed separately)
CLIENT_URL="http://localhost:3000"

# Frontend API Base URL (Set on Vercel to your Render backend URL, leave empty for unified dev server)
VITE_API_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
